# Copy to .streamlit/secrets.toml locally (git-ignored, never commit it), or paste into
# Streamlit Cloud → your app → Settings → Secrets.

# Profiles, send history and saved searches. MongoDB Atlas → Connect → Drivers.
# Under Network Access allow 0.0.0.0/0 (Streamlit Cloud has no fixed IP).
MONGODB_URI = "mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/bulk_email_sender?retryWrites=true&w=majority"

# The app's shared keys: used for anyone (guests too) who hasn't added their own key in their profile.
# They are never shown to users. Usage is billed to these accounts.
APIFY_TOKEN = "apify_api_..."
GROQ_API_KEY = "gsk_..."
GEMINI_API_KEY = "AIza..."
